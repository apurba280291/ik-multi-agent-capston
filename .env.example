# Copy to .env (or export in your shell). Every key is optional.
# With no LLM key the app runs in offline mode with grounded template answers.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Market data: yfinance needs no key. Alpha Vantage is optional.
ALPHA_VANTAGE_API_KEY=

# Optional overrides of config.yaml
# FINANCE_LLM_PROVIDER=offline
# FINANCE_MARKET_PROVIDER=mock
# FINANCE_CONFIG=config.yaml
